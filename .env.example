# SerpAPI
SEARCH_API_KEY=your_serpapi_key
# google_maps | google_local | google
SEARCH_ENGINE=google_maps
# fetch each result's website to extract email / phone / owner name
SEARCH_ENRICH_WEBSITES=true

# Gmail SMTP (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your_app_password
SEND_DELAY=5

WHATSAPP_NUMBER=+1 555 010 0000
UNSUBSCRIBE_BASE_URL=http://localhost:5000/unsubscribe
SECRET_KEY=change-me
